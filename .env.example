## Supabase — required for the "Avis clients" (testimonials), "Contact" and "/admin" features.
## Get these from your Supabase project settings > API.
## Copy this file to .env.local and fill in the real values (never commit .env.local).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

## Server-only — never prefix with NEXT_PUBLIC_, never expose to the browser.
## Used only in app/api/* server routes to bypass RLS on insert.
SUPABASE_SERVICE_ROLE_KEY=